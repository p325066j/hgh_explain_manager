// Prisma schema defining the domain models for HGH Explain Manager.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VisibilitySyncStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum AuditEntityType {
  VIDEO
  CATEGORY
  VISIBILITY_SYNC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SYNC
}

model Category {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  order           Int             @default(0)
  videoCategories VideoCategory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Video {
  /// YouTube の videoId を主キーとして使用する
  id                   String               @id
  title                String
  description          String
  complications        String?
  precautions          String?
  procedures           String?
  duration             Int?
  fileUrl              String
  thumbnailUrl         String?
  isVisible            Boolean              @default(false)
  isArchived           Boolean              @default(false)
  isVisibilityDirty    Boolean              @default(false)
  visibilitySyncStatus VisibilitySyncStatus @default(PENDING)
  visibilitySyncedAt   DateTime?
  visibilitySyncError  String?
  videoCategories      VideoCategory[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([isVisible])
  @@index([isArchived])
  @@index([isVisibilityDirty])
}

model VideoCategory {
  videoId    String
  categoryId String
  order      Int      @default(0)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([videoId, categoryId])
  @@index([categoryId])
  @@index([videoId])
  @@index([categoryId, order])
}

model AuditLog {
  id         String          @id @default(cuid())
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  message    String?
  meta       Json?
  createdAt  DateTime        @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}